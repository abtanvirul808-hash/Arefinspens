{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A writing instrument product listed in Arefin's Pen storefront.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "brand": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": {
          "type": "string",
          "enum": [
            "gel-pens",
            "ballpoint-pens",
            "fountain-pens",
            "marker-pens",
            "mechanical-pencils",
            "highlighters"
          ]
        },
        "categoryLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "shortDescription": { "type": "string", "minLength": 1, "maxLength": 400 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "priceBdt": { "type": "number" },
        "originalPriceBdt": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "popularityScore": { "type": "integer" },
        "featured": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "inStock": { "type": "boolean" },
        "stockCount": {
          "type": "integer",
          "description": "Auto-calculated total available quantity across all in-stock colour variants."
        },
        "images": { "type": "array" },
        "colors": {
          "type": "array",
          "description": "List of body colour variants with id, name, hex, inStock, per-colour stockCount, optional image URL, and inkColors combo array."
        },
        "specs": {
          "type": "object",
          "description": "Technical pen specifications including tipSize, inkType, inkColor, inkColorHex, multi-select inkColors array, bodyMaterial, weight, and origin."
        },
        "sampleReviews": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "slug",
        "name",
        "brand",
        "category",
        "categoryLabel",
        "shortDescription",
        "description",
        "priceBdt",
        "rating",
        "reviewCount",
        "popularityScore",
        "inStock",
        "stockCount",
        "images",
        "colors",
        "specs",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "An authenticated customer Cash on Delivery order record visible strictly to the placing user (matching uid or verified sign-in email) and verified admins in the Admin Panel.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^#[0-9]+$" },
        "serialNumber": { "type": "integer" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userEmail": { "type": "string", "minLength": 3, "maxLength": 200 },
        "phone": { "type": "string", "minLength": 8, "maxLength": 20 },
        "phoneSuffix": { "type": "string", "minLength": 6, "maxLength": 10 },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "academyClass": { "type": "string", "enum": ["5", "6", "7"] },
        "address": { "type": "string", "minLength": 3, "maxLength": 400 },
        "paymentMethod": { "type": "string", "enum": ["cod"] },
        "totalBdt": { "type": "number" },
        "itemsSummary": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "orderItems": {
          "type": "array",
          "description": "Structured ordered items (productId, productName, colorId, colorName, optional inkColorId/inkColorName, quantity) used for atomic stock deduction and order-deletion restoration."
        },
        "placedAt": { "type": "string", "minLength": 2, "maxLength": 80 },
        "currentStageIndex": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderId",
        "serialNumber",
        "userId",
        "userEmail",
        "phone",
        "phoneSuffix",
        "customerName",
        "city",
        "address",
        "paymentMethod",
        "totalBdt",
        "itemsSummary",
        "placedAt",
        "currentStageIndex",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoreMeta": {
      "title": "StoreMeta",
      "description": "Metadata document for catalog seeding and global serial order counter starting at #1.",
      "type": "object",
      "properties": {
        "seeded": { "type": "boolean" },
        "lastOrderNumber": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["updatedAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Live storefront product catalogue readable by all visitors and managed by admins."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders isolated strictly to the placing user (userId == auth.uid or userEmail == auth.token.email) and verified admins."
    },
    "/meta/{metaId}": {
      "schema": { "$ref": "#/entities/StoreMeta" },
      "description": "Storefront metadata including global serial order counter (#1, #2, #3...) and initial seed flag."
    }
  }
}
