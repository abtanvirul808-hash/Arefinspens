rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email.size() >= 3;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email.lower() == 'a.b.tanvirul808@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidCategory(cat) {
      return cat in [
        'gel-pens',
        'ballpoint-pens',
        'fountain-pens',
        'marker-pens',
        'mechanical-pencils',
        'highlighters',
        'other-products'
      ];
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
        'id', 'slug', 'name', 'brand', 'category', 'categoryLabel',
        'shortDescription', 'description', 'priceBdt', 'rating',
        'reviewCount', 'popularityScore', 'inStock', 'stockCount',
        'images', 'colors', 'specs', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'slug', 'name', 'brand', 'category', 'categoryLabel',
        'shortDescription', 'description', 'priceBdt', 'originalPriceBdt',
        'rating', 'reviewCount', 'popularityScore', 'orderCount', 'featured', 'featuredUntilMs', 'featuredOrder', 'isNew',
        'inStock', 'stockCount', 'images', 'colors', 'specs', 'sampleReviews',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.slug) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
      data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 80 &&
      data.category is string && isValidCategory(data.category) &&
      data.categoryLabel is string && data.categoryLabel.size() >= 1 && data.categoryLabel.size() <= 80 &&
      data.shortDescription is string && data.shortDescription.size() >= 1 && data.shortDescription.size() <= 400 &&
      data.description is string && data.description.size() >= 1 && data.description.size() <= 2000 &&
      data.priceBdt is number && data.priceBdt > 0 && data.priceBdt <= 1000000 &&
      (!('originalPriceBdt' in data) || (data.originalPriceBdt is number && data.originalPriceBdt > 0 && data.originalPriceBdt <= 1000000)) &&
      data.rating is number && data.rating >= 0 && data.rating <= 5 &&
      data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 1000000 &&
      data.popularityScore is int && data.popularityScore >= 0 && data.popularityScore <= 1000 &&
      (!('orderCount' in data) || (data.orderCount is int && data.orderCount >= 0 && data.orderCount <= 10000000)) &&
      (!('featured' in data) || data.featured is bool) &&
      (!('featuredUntilMs' in data) || (data.featuredUntilMs is int && data.featuredUntilMs >= 0 && data.featuredUntilMs <= 9999999999999)) &&
      (!('featuredOrder' in data) || (data.featuredOrder is int && data.featuredOrder >= 1 && data.featuredOrder <= 10000)) &&
      (!('isNew' in data) || data.isNew is bool) &&
      data.inStock is bool &&
      data.stockCount is int && data.stockCount >= 0 && data.stockCount <= 1000000 &&
      data.images is list && data.images.size() <= 12 &&
      (data.images.size() == 0 || data.images[0] is string) &&
      data.colors is list && data.colors.size() >= 1 && data.colors.size() <= 12 &&
      data.colors[0] is map &&
      data.specs is map &&
      (!('sampleReviews' in data) || (data.sampleReviews is list && data.sampleReviews.size() <= 20)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidOrderItem(item) {
      return item is map &&
        item.keys().hasAll(['productId', 'productName', 'colorId', 'colorName', 'quantity']) &&
        item.keys().hasOnly([
          'productId', 'productName', 'colorId', 'colorName',
          'inkColorId', 'inkColorName', 'quantity'
        ]) &&
        isValidId(item.productId) &&
        item.productName is string && item.productName.size() >= 1 && item.productName.size() <= 120 &&
        isValidId(item.colorId) &&
        item.colorName is string && item.colorName.size() >= 1 && item.colorName.size() <= 80 &&
        (!('inkColorId' in item) || isValidId(item.inkColorId)) &&
        (!('inkColorName' in item) || (item.inkColorName is string && item.inkColorName.size() >= 1 && item.inkColorName.size() <= 60)) &&
        item.quantity is int && item.quantity >= 1 && item.quantity <= 10000;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
        'orderId', 'serialNumber', 'userId', 'userEmail', 'phone', 'phoneSuffix',
        'customerName', 'city', 'address', 'paymentMethod', 'totalBdt',
        'itemsSummary', 'placedAt', 'currentStageIndex', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderId', 'serialNumber', 'userId', 'userEmail', 'phone', 'phoneSuffix',
        'customerName', 'city', 'academyClass', 'address', 'paymentMethod', 'totalBdt',
        'itemsSummary', 'orderItems', 'placedAt', 'currentStageIndex', 'createdAt', 'updatedAt'
      ]) &&
      data.orderId is string && data.orderId.size() >= 2 && data.orderId.size() <= 32 &&
      data.orderId.matches('^#[0-9]+$') &&
      data.serialNumber is int && data.serialNumber >= 1 && data.serialNumber <= 10000000 &&
      isValidId(data.userId) &&
      data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 200 &&
      data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20 &&
      data.phoneSuffix is string && data.phoneSuffix.size() >= 6 && data.phoneSuffix.size() <= 10 &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
      data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
      (!('academyClass' in data) || (data.academyClass is string && data.academyClass in ['5', '6', '7'])) &&
      (data.city != 'Al Amanah Academy' || ('academyClass' in data && data.academyClass in ['5', '6', '7'])) &&
      data.address is string && data.address.size() >= 3 && data.address.size() <= 400 &&
      data.paymentMethod == 'cod' &&
      data.totalBdt is number && data.totalBdt >= 0 && data.totalBdt <= 10000000 &&
      data.itemsSummary is string && data.itemsSummary.size() >= 2 && data.itemsSummary.size() <= 1000 &&
      (!('orderItems' in data) || (
        data.orderItems is list &&
        data.orderItems.size() <= 30 &&
        (data.orderItems.size() == 0 || isValidOrderItem(data.orderItems[0]))
      )) &&
      data.placedAt is string && data.placedAt.size() >= 2 && data.placedAt.size() <= 80 &&
      data.currentStageIndex is int && data.currentStageIndex >= 0 && data.currentStageIndex <= 4 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStoreMeta(data) {
      return data.keys().hasAll(['updatedAt']) &&
      data.keys().hasOnly(['seeded', 'lastOrderNumber', 'updatedAt']) &&
      (!('seeded' in data) || data.seeded is bool) &&
      (!('lastOrderNumber' in data) || (data.lastOrderNumber is int && data.lastOrderNumber >= 0 && data.lastOrderNumber <= 10000000)) &&
      data.updatedAt is timestamp;
    }

    function isCustomerOrderStockDeduction() {
      return isVerified() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['inStock', 'stockCount', 'colors', 'orderCount', 'updatedAt']) &&
        existing().inStock == true &&
        existing().stockCount is number &&
        incoming().stockCount is int &&
        incoming().stockCount >= 0 &&
        incoming().stockCount < existing().stockCount &&
        ((incoming().stockCount > 0 && incoming().inStock == true) || (incoming().stockCount == 0 && incoming().inStock == false)) &&
        incoming().colors.size() == existing().colors.size() &&
        (
          !('orderCount' in incoming().diff(existing()).affectedKeys()) ||
          (
            incoming().orderCount is int &&
            (
              (!('orderCount' in existing()) && incoming().orderCount == (existing().stockCount - incoming().stockCount)) ||
              ('orderCount' in existing() && existing().orderCount is int && incoming().orderCount == existing().orderCount + (existing().stockCount - incoming().stockCount))
            )
          )
        ) &&
        (
          (
            exists(/databases/$(database)/documents/meta/orderCounter) &&
            getAfter(/databases/$(database)/documents/meta/orderCounter).data.lastOrderNumber ==
              get(/databases/$(database)/documents/meta/orderCounter).data.lastOrderNumber + 1
          ) || (
            !exists(/databases/$(database)/documents/meta/orderCounter) &&
            getAfter(/databases/$(database)/documents/meta/orderCounter).data.lastOrderNumber == 1
          )
        );
    }

    function isValidProductRating(data) {
      return data.keys().hasAll([
        'id', 'productId', 'userId', 'customerName', 'rating', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'productId', 'userId', 'customerName', 'rating', 'comment', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.productId) &&
      isValidId(data.userId) &&
      data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
      data.rating is int && data.rating >= 1 && data.rating <= 5 &&
      (!('comment' in data) || (data.comment is string && data.comment.size() <= 400)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Storefront products: public read, admin-full write, verified-customer atomic stock deduction on checkout
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().id == productId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          isCustomerOrderStockDeduction()
        );
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Customer product ratings & public reviews (no PII stored)
    match /productRatings/{ratingId} {
      allow get, list: if true;
      allow create: if isVerified() &&
        isValidId(ratingId) &&
        isValidProductRating(incoming()) &&
        incoming().id == ratingId &&
        incoming().userId == request.auth.uid &&
        ratingId == (incoming().productId + '__' + request.auth.uid) &&
        exists(/databases/$(database)/documents/products/$(incoming().productId)) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(ratingId) &&
        isValidProductRating(incoming()) &&
        incoming().id == existing().id &&
        incoming().productId == existing().productId &&
        incoming().userId == existing().userId &&
        existing().userId == request.auth.uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(ratingId) && (
        isAdmin() ||
        (isVerified() && existing().userId == request.auth.uid)
      );
    }

    // Customer orders (contains PII): strictly isolated to owner (matching uid or verified sign-in email) or verified admin
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isVerified() && (
          existing().userId == request.auth.uid ||
          existing().userEmail == request.auth.token.email
        ))
      );
      allow list: if isAdmin() || (
        isVerified() && (
          resource.data.userId == request.auth.uid ||
          resource.data.userEmail == request.auth.token.email
        )
      );
      allow create: if isVerified() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().userEmail == request.auth.token.email &&
        incoming().currentStageIndex == 1 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().orderId == ('#' + string(incoming().serialNumber)) &&
        orderId == ('order-' + string(incoming().serialNumber)) &&
        getAfter(/databases/$(database)/documents/meta/orderCounter).data.lastOrderNumber == incoming().serialNumber;
      allow update: if isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().userEmail == existing().userEmail &&
        incoming().orderId == existing().orderId &&
        incoming().serialNumber == existing().serialNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['currentStageIndex', 'updatedAt']) &&
        isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    function isValidChatPlatform(platform) {
      return platform in [
        'whatsapp',
        'messenger',
        'telegram',
        'imo',
        'viber',
        'wechat',
        'line',
        'discord',
        'signal',
        'instagram',
        'facebook',
        'phone',
        'email',
        'custom'
      ];
    }

    function isValidChatChannel(ch) {
      return ch is map &&
        ch.keys().hasAll(['id', 'platform', 'label', 'handle', 'url', 'enabled']) &&
        ch.keys().hasOnly([
          'id', 'platform', 'label', 'handle', 'url',
          'prefillMessage', 'iconStyle', 'customIconUrl', 'color', 'enabled'
        ]) &&
        isValidId(ch.id) &&
        ch.platform is string && isValidChatPlatform(ch.platform) &&
        ch.label is string && ch.label.size() >= 1 && ch.label.size() <= 60 &&
        ch.handle is string && ch.handle.size() <= 180 &&
        ch.url is string && ch.url.size() <= 400 &&
        (
          ch.url.size() == 0 ||
          ch.url.matches('^https?://.*') ||
          ch.url.matches('^mailto:.*') ||
          ch.url.matches('^tel:.*') ||
          ch.url.matches('^viber://.*') ||
          ch.url.matches('^tg://.*')
        ) &&
        (!('prefillMessage' in ch) || (ch.prefillMessage is string && ch.prefillMessage.size() <= 300)) &&
        (!('iconStyle' in ch) || (
          ch.iconStyle is string &&
          ch.iconStyle in [
            'platform', 'whatsapp-classic', 'whatsapp-bubble',
            'chat-spark', 'headset', 'send', 'phone', 'custom-image'
          ]
        )) &&
        (!('customIconUrl' in ch) || (
          ch.customIconUrl is string &&
          ch.customIconUrl.size() <= 80000 &&
          (
            ch.customIconUrl.size() == 0 ||
            ch.customIconUrl.matches('^https?://.*') ||
            ch.customIconUrl.matches('^data:image/(png|jpeg|jpg|webp|gif);base64,.*')
          )
        )) &&
        (!('color' in ch) || (ch.color is string && (ch.color.matches('^#[0-9a-fA-F]{6}$') || ch.color == 'liquid-glass'))) &&
        ch.enabled is bool;
    }

    function isValidChatWidget(data) {
      return data.keys().hasAll([
        'enabled', 'whatsappNumber', 'prefillMessage', 'iconStyle', 'buttonColor', 'channels', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'enabled', 'whatsappNumber', 'whatsappLink', 'whatsappLabel', 'prefillMessage',
        'buttonLabel', 'iconStyle', 'customIconUrl', 'buttonColor', 'buttonSize', 'channels', 'updatedAt'
      ]) &&
      data.enabled is bool &&
      data.whatsappNumber is string && data.whatsappNumber.size() <= 30 &&
      (!('whatsappLink' in data) || (
        data.whatsappLink is string &&
        data.whatsappLink.size() <= 400 &&
        (data.whatsappLink.size() == 0 || data.whatsappLink.matches('^https?://.*'))
      )) &&
      (!('whatsappLabel' in data) || (data.whatsappLabel is string && data.whatsappLabel.size() <= 60)) &&
      data.prefillMessage is string && data.prefillMessage.size() <= 300 &&
      (!('buttonLabel' in data) || (data.buttonLabel is string && data.buttonLabel.size() <= 60)) &&
      data.iconStyle is string && data.iconStyle in [
        'whatsapp-classic', 'whatsapp-bubble', 'chat-spark', 'headset', 'send', 'custom-image'
      ] &&
      (!('customIconUrl' in data) || (
        data.customIconUrl is string &&
        data.customIconUrl.size() <= 260000 &&
        (
          data.customIconUrl.size() == 0 ||
          data.customIconUrl.matches('^https?://.*') ||
          data.customIconUrl.matches('^data:image/(png|jpeg|jpg|webp|gif);base64,.*')
        )
      )) &&
      data.buttonColor is string && (data.buttonColor.matches('^#[0-9a-fA-F]{6}$') || data.buttonColor == 'liquid-glass') &&
      (!('buttonSize' in data) || (data.buttonSize is int && data.buttonSize >= 40 && data.buttonSize <= 96)) &&
      data.channels is list &&
      data.channels.size() <= 10 &&
      (data.channels.size() == 0 || isValidChatChannel(data.channels[0])) &&
      data.updatedAt is timestamp;
    }

    // Floating WhatsApp & multi-messaging launcher config: public read, verified admin write
    match /meta/chatWidget {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if isAdmin() &&
        isValidChatWidget(incoming()) &&
        incoming().updatedAt == request.time;
    }

    // Storefront metadata (serial counter starting from 1 + catalog seed flag)
    match /meta/{metaId} {
      allow get: if isValidId(metaId) && metaId != 'chatWidget';
      allow list: if false;
      allow create: if isVerified() &&
        isValidId(metaId) &&
        metaId != 'chatWidget' &&
        isValidStoreMeta(incoming()) &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (metaId == 'orderCounter' && incoming().keys().hasOnly(['lastOrderNumber', 'updatedAt']) && incoming().lastOrderNumber == 1)
        );
      allow update: if isVerified() &&
        isValidId(metaId) &&
        metaId != 'chatWidget' &&
        isValidStoreMeta(incoming()) &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            metaId == 'orderCounter' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastOrderNumber', 'updatedAt']) &&
            incoming().lastOrderNumber == existing().lastOrderNumber + 1
          )
        );
      allow delete: if false;
    }

    // Admin UID allowlist (read-only by owner)
    match /admins/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
